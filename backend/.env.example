NODE_ENV=development
PORT=3000

# Banco de dados (use DATABASE_URL em produção / Render)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=devpath
DB_PASSWORD=devpath_secret
DB_DATABASE=devpath
DB_SSL=false

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Avaliação
ASSESSMENT_PASS_SCORE=70

# Provedor LLM: groq | openai | mock
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI (alternativa)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Seed
SEED_DATABASE=false

# Logs
LOG_LEVEL=info
